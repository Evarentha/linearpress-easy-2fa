{
  "id": "easy-2fa",
  "name": "两步验证",
  "version": "4.0.0",
  "description": "登录时除密码外再输入手机验证器（TOTP）上的验证码；可选、强制两种模式，一次性还原码，可选通行密钥。对所有登录方式生效，包括单点登录。",
  "author": "LinearPress",
  "icon": "2FA",
  "type": "both",
  "main": "index.ts",
  "views": "views",
  "public": "public",
  "settings": "/admin/two-factor",
  "styles": [
    { "file": "easy-2fa.css", "scope": "all", "paths": ["/login/2fa", "/account/two-factor", "/admin/two-factor"] }
  ],
  "scripts": [
    { "file": "easy-2fa.js", "scope": "all", "paths": ["/login/2fa", "/account/two-factor"] }
  ],
  "permissions": [
    { "id": "easy-2fa:manage", "label": "管理两步验证（为用户关闭）", "group": "用户" }
  ]
}
